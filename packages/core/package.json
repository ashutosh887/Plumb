{
  "name": "@plumb/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decoders": {
      "types": "./dist/decoders/index.d.ts",
      "default": "./dist/decoders/index.js"
    },
    "./risk": {
      "types": "./dist/risk/index.d.ts",
      "default": "./dist/risk/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@solana/kit": "^2.0.0",
    "@solana/web3.js": "^1.95.4",
    "@sqds/multisig": "^2.1.4",
    "@coral-xyz/anchor": "^0.30.1",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
